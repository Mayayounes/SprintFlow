@host = https://localhost
@port = 7000
@sprintFlow.api_HostAddress = {{host}}:{{port}} 
@token =eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..O38JUJJgHjtQPGjcMIuTR-4Ln3SJQ0cSrGIECqd0IiQ
###
# GET all users
GET {{sprintFlow.api_HostAddress}}/api/users?role=employee&pageNumber=1&pageSize=10


###
# login
POST {{sprintFlow.api_HostAddress}}/api/login
Content-Type : application/json
{
    "email": "Nounou@test.com",
    "password": "Nounou123."
}
###

# Register a user
POST {{sprintFlow.api_HostAddress}}/api/identity/register
Content-Type : application/json
{
  "email" : "nounou@test.com",
  "password" : "Nounou123.",
}
###
//assign user to role
POST {{sprintFlow.api_HostAddress}}/api/identity/assignRole
Content-Type : application/json
Authorization : Bearer {{token}}
{
  "Email" : "ola@test.com",
  "Role" : "employee"
}
###
//change user role
PATCH {{sprintFlow.api_HostAddress}}/api/identity/changeRole
Content-Type : application/json
Authorization : Bearer {{token}}
{
  "Email" : "ola@test.com",
  "NewRole" : "employee"
}
###
//delete user
DELETE {{sprintFlow.api_HostAddress}}/api/identity/deleteUser
content-Type : application/json
Authorization : Bearer {{token}}
{
  "Email" : "ola@test.com"
}
###
//projects

# Create project
POST {{sprintFlow.api_HostAddress}}/api/projects/create
content-Type : application/json
Authorization : Bearer {{token}}
{
  "Name" : "project",
  "Description" : "project description"
}
###
# show all projects
GET {{sprintFlow.api_HostAddress}}/api/projects/searchPhrase=task?pageNumber=1&pageSize=10
content-Type : application/json
Authorization : Bearer {{token}}
###
# show single project
GET {{sprintFlow.api_HostAddress}}/api/projects/d750ce3d-37a0-469e-b505-08de928b249c
content-Type : application/json
Authorization : Bearer {{token}}
###
# edit project
PATCH {{sprintFlow.api_HostAddress}}/api/projects/d750ce3d-37a0-469e-b505-08de928b249c
content-Type : application/json
Authorization : Bearer {{token}}
{
  "Name" : "project",
  "Description" : "project description"
}
###
GET {{sprintFlow.api_HostAddress}}/api/projects/abade627-3a79-4680-f640-08de94d57baf/tasks?pageNumber=1&pageSize=10
content-Type : application/json
Authorization : Bearer {{token}}
